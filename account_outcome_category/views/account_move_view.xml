    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
			<group id="other_tab_group" position="inside">
                <group name="outcomer_group" string="Clasificación de gastos" invisible="move_type in ('out_invoice', 'out_refund')">
                    <field name="account_outcome_category_1"/>
                    <field name="account_outcome_category_2"/>
                    <field name="account_outcome_category_multiple"/>                    
                </group>
            </group>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='invoice_tab']/field[@name='invoice_line_ids']/tree[1]/field[@name='price_unit']" position="after">
                <field name="account_outcome_category_1" column_invisible="parent.move_type in ('out_invoice', 'out_refund')" optional="show" />
                <field name="account_outcome_category_2" column_invisible="parent.move_type in ('out_invoice', 'out_refund')" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
